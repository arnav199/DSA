   "outputs": [],
   "source": [
    "'through BFS'\n",
    "def maxdepth (root)\n",
    "    if root is None:\n",
    "        return 0\n",
    "    l = maxdepth(root.left)\n",
    "    r = maxdepth(root.right)\n",
    "    return max(l,r) + 1\n",
    "\n"
   ]
  }
