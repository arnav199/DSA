    "def Postorde (self, root):\n",
    "    l1 = []\n",
    "    self.traverse(root, l1)\n",
    "    return\n",
    "def traverse (self, root, l1)\n",
    "    if root is None:\n",
    "        return\n",
    "    traverse(root.left, l1)\n",
    "    traverse(root.right, l1)\n",
    "    traverse(root.val, l1)"
